{
  "name": "barshik-nepali-patro",
  "version": "1.0.0",
  "description": "A precise, zero-dependency Bikram Sambat (BS) calendar library for React & React Native with official Nepali month data, holiday support, and graceful fallback for future years.",
  "keywords": [
    "nepali-calendar",
    "bikram-sambat",
    "bs-calendar",
    "nepal",
    "nepali-date",
    "react-calendar",
    "react-native-calendar",
    "nepali-patro"
  ],
  "homepage": "https://github.com/Abhishek-Gaire/nepali-patro#readme",
  "bugs": {
    "url": "https://github.com/Abhishek-Gaire/nepali-patro/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhishek-Gaire/nepali-patro.git"
  },
  "license": "MIT",
  "author": "Abhishek Gaire <abhishekgaire@protonmail.com>",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./native": {
      "import": {
        "types": "./dist/native.d.ts",
        "default": "./dist/native.esm.js"
      },
      "require": {
        "types": "./dist/native.d.ts",
        "default": "./dist/native.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.esm.js"
      },
      "require": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      }
    }
  },
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.28.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "react": "^19.2.6",
    "react-native": "^0.85.3",
    "rollup": "^4.60.3",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  }
}
